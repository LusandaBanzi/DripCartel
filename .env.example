NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
# Use "none" when the API and frontend are on different sites (for example github.io + a separate API domain).
# Use "lax" when both use the same registrable domain, such as dripcartel.co.za + api.dripcartel.co.za.
COOKIE_SAMESITE=lax
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/dripcartel
DATABASE_SSL=true
DATABASE_CA=
TRUST_PROXY=
DB_POOL_MAX=10

# Separate secrets: never commit real values.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_32_CHARS_MINIMUM
AUTH_PEPPER=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET

# Customer verification is WhatsApp-first.
# For local development use console. For production use Meta WhatsApp Cloud API.
WHATSAPP_PROVIDER=console
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_OTP_TEMPLATE=dripcartel_verify
WHATSAPP_RESET_TEMPLATE=dripcartel_password_reset
WHATSAPP_TEMPLATE_LANGUAGE=en_US
DEFAULT_COUNTRY_CODE=27

# Optional transactional email fallback/receipts. Account verification is NOT email-based.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=DripCartel <noreply@example.com>

# Paystack is server-side only. Never expose PAYSTACK_SECRET_KEY to frontend code.
PAYSTACK_SECRET_KEY=

# First-run admin bootstrap. In production, set a long random token and enter it once.
ADMIN_SETUP_TOKEN=fdc11283f3193563115e11f7082883fc8803edb944b37362e90c8f9e6c56bbf6
EXPOSE_SESSION_IP=false

# Private admin discovery code. This only reveals the admin entry point; it is NOT the admin password.
ADMIN_DISCOVERY_CODE=replace-with-a-long-random-private-code
